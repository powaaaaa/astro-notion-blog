---
// 5a All posts — 全記事一覧(ページネーションなし・全件)
import { getAllPosts } from '../../lib/notion/client.ts'
import { getPostLink } from '../../lib/blog-helpers.ts'
import { formatDate } from '../../lib/custom.ts'
import Layout from '../../layouts/Layout.astro'
import NoContents from '../../components/NoContents.astro'
import PostHero from '../../components/PostHero.astro'
import PostRow from '../../components/PostRow.astro'

const posts = await getAllPosts()
---

<Layout title="Posts" description="" path="/posts" ogImage="">
  <div slot="main">
    <PostHero title="Posts" count={posts.length} />

    {
      posts.length === 0 ? (
        <NoContents contents={posts} />
      ) : (
        <ul class="list">
          {posts.map((post) => (
            <PostRow
              date={formatDate(post.Date)}
              title={post.Title}
              href={getPostLink(post.Slug)}
              tags={post.Tags.map((tag) => tag.name)}
              showTags
            />
          ))}
        </ul>
      )
    }
  </div>
</Layout>

<style>
  .list {
    list-style: none;
    margin: 0 0 40px;
    padding: 0;
  }
</style>
