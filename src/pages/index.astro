---
// 2a Home — quiet index
import { NUMBER_OF_POSTS_PER_PAGE } from '../server-constants.ts'
import {
  getPosts,
  getAllPosts,
  getAllTags,
  getDatabase,
} from '../lib/notion/client.ts'
import { getPostLink, getNavLink } from '../lib/blog-helpers.ts'
import { getTagLink, formatDate } from '../lib/custom.ts'
import Layout from '../layouts/Layout.astro'
import NoContents from '../components/NoContents.astro'
import IntroBlock from '../components/home/IntroBlock.astro'
import SectionLabel from '../components/SectionLabel.astro'
import TagPill from '../components/TagPill.astro'
import MoreLink from '../components/MoreLink.astro'
import PostRow from '../components/PostRow.astro'

const [posts, allPosts, tags, database] = await Promise.all([
  getPosts(NUMBER_OF_POSTS_PER_PAGE),
  getAllPosts(),
  getAllTags(),
  getDatabase(),
])

// タグごとの記事数を集計し、多い順に並べる
const tagCounts = new Map<string, number>()
allPosts
  .flatMap((post) => post.Tags)
  .forEach((tag) => {
    tagCounts.set(tag.name, (tagCounts.get(tag.name) || 0) + 1)
  })
const sortedTags = [...tags].sort(
  (a, b) => (tagCounts.get(b.name) || 0) - (tagCounts.get(a.name) || 0)
)
---

<Layout>
  <div slot="main" class="home">
    <IntroBlock bio={database.Description} />

    <SectionLabel label="TAGS">
      <MoreLink href={getNavLink('/tags')} />
    </SectionLabel>
    <nav class="tags">
      {
        sortedTags.map((tag) => (
          <TagPill
            name={tag.name}
            count={tagCounts.get(tag.name) || 0}
            href={getTagLink(tag.name)}
          />
        ))
      }
    </nav>

    <SectionLabel label="POSTS">
      <MoreLink href={getNavLink('/posts')} />
    </SectionLabel>
    {
      posts.length === 0 ? (
        <NoContents contents={posts} />
      ) : (
        <ul class="list">
          {posts.map((post) => (
            <PostRow
              date={formatDate(post.Date)}
              title={post.Title}
              href={getPostLink(post.Slug)}
            />
          ))}
        </ul>
      )
    }
  </div>
</Layout>

<style>
  .tags {
    padding: 6px 0 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .list {
    list-style: none;
    margin: 0 0 22px;
    padding: 0;
  }
</style>
