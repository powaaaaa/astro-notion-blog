---
// 03 IntroBlock — トップページの自己紹介ブロック
export interface Props {
  name?: string
  profileHref?: string
  bio: string
}

const { name = '', profileHref = '', bio } = Astro.props
---

<section class="intro">
  {
    name && (
      <div class="who">
        {name}
        {profileHref && (
          <a class="plink" href={profileHref}>
            → profile
          </a>
        )}
      </div>
    )
  }
  <p>{bio}</p>
</section>

<style>
  .intro {
    padding: 28px 0 22px;
  }
  .who {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--fg);
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .plink {
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 400;
    color: var(--fg-4);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    padding-bottom: 1px;
  }
  .plink:hover {
    color: var(--fg);
    border-bottom-color: var(--fg);
  }
  .intro p {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--fg-3);
    line-height: 1.55;
    max-width: 380px;
  }
  .who + p {
    margin-top: 8px;
  }
  .intro p:first-child {
    margin-top: 0;
  }
</style>
