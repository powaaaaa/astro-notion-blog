---
// SearchButton — ヘッダー用の検索ボタン(⌘K でも開く)
---

<button
  class="ic open-search-modal"
  type="button"
  title="検索 (⌘K)"
  aria-label="検索"
>
  <svg
    width="13"
    height="13"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
  >
    <circle cx="7" cy="7" r="4.5"></circle>
    <path d="M10.5 10.5L14 14"></path>
  </svg>
</button>

<style>
  .ic {
    width: 30px;
    height: 30px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: grid;
    place-items: center;
    color: var(--fg-3);
    background: var(--bg-raised);
    cursor: pointer;
    padding: 0;
  }
  .ic:hover {
    color: var(--fg);
    border-color: var(--fg-3);
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    function handleKeydown(event) {
      if (event.keyCode === 75 && (event.metaKey || event.ctrlKey)) {
        // Cmd+K / Ctrl+K
        event.preventDefault()
        document.querySelector('.open-search-modal').click()
      }
    }

    document.addEventListener('keydown', handleKeydown)
  })
</script>
