---
// 16 TagIndexList — タグ一覧ページ(3b)用のタグピル一覧
export interface Props {
  tags: { name: string; count: number; href: string }[]
  sort?: 'count' | 'name'
}

const { tags, sort = 'count' } = Astro.props

const sorted = [...tags].sort((a, b) =>
  sort === 'count' ? b.count - a.count : a.name.localeCompare(b.name)
)
---

<ul class="tg-list">
  {
    sorted.map((tag) => (
      <li>
        <a href={tag.href}>
          <span class="tg-n">{tag.name}</span>
          <span class="tg-c">{tag.count}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tg-list {
    list-style: none;
    margin: 0;
    padding: 8px 0 18px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
  }
  .tg-list li {
    display: inline-flex;
  }
  .tg-list a {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg-raised);
    color: var(--fg-2);
    text-decoration: none;
    transition:
      border-color 0.12s,
      color 0.12s;
  }
  .tg-list a:hover {
    border-color: var(--fg);
    color: var(--fg);
  }
  .tg-n {
    color: inherit;
  }
  .tg-c {
    color: var(--fg-5);
    font-size: 10.5px;
  }
</style>
