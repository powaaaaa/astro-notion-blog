---
// 18 TerminalBlock — 6a の疑似ターミナル
// 行を配列で渡す設計(他の遊び場でも流用可)
export interface Props {
  lines: ({ cmd: string } | { out: string })[]
  caret?: boolean
}

const { lines, caret = true } = Astro.props
---

<div class="term">
  {
    lines.map((line) =>
      'cmd' in line ? (
        <div>
          <span class="prompt">$</span>
          <span class="cmd">{line.cmd}</span>
        </div>
      ) : (
        <span class="out">{line.out}</span>
      )
    )
  }
  {
    caret && (
      <div>
        <span class="prompt">$</span>
        <span class="caret" />
      </div>
    )
  }
</div>

<style>
  .term {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.75;
    color: var(--fg-2);
  }
  .prompt {
    color: var(--fg-5);
    user-select: none;
    margin-right: 6px;
  }
  .cmd {
    color: var(--fg);
  }
  .out {
    color: var(--fg-3);
    display: block;
    padding-left: 14px;
  }
  .caret {
    display: inline-block;
    width: 7px;
    height: 14px;
    background: var(--fg);
    vertical-align: -2px;
    animation: blk 1s steps(2) infinite;
  }
  @keyframes blk {
    50% {
      opacity: 0;
    }
  }
</style>
