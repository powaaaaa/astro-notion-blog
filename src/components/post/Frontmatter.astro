---
// 10 Frontmatter — 記事メタ情報の帯(date / updated / read / tags)
// 整列: narrow は左寄せ、768px 以上で中央寄せ
import type { SelectProperty } from '../../lib/interfaces.ts'
import { getTagLink } from '../../lib/custom.ts'

export interface Props {
  date: string
  updated?: string
  readMinutes?: number
  tags?: SelectProperty[]
}

const { date, updated = '', readMinutes = 0, tags = [] } = Astro.props
---

<div class="fm">
  <div class="line">
    <span class="row"><span class="k">date</span><span class="v">{date}</span></span>
    {
      updated && (
        <>
          <span class="dot">·</span>
          <span class="row">
            <span class="k">updated</span>
            <span class="v">{updated}</span>
          </span>
        </>
      )
    }
    {
      readMinutes > 0 && (
        <>
          <span class="dot">·</span>
          <span class="row">
            <span class="k">read</span>
            <span class="v">{readMinutes} min</span>
          </span>
        </>
      )
    }
  </div>
  {
    tags.length > 0 && (
      <div class="line">
        <span class="row row-tags">
          <span class="k">tags</span>
          <span class="v">
            {tags.map((tag, i) => (
              <>
                {i > 0 && ', '}
                <a href={getTagLink(tag.name)}>{tag.name}</a>
              </>
            ))}
          </span>
        </span>
      </div>
    )
  }
</div>

<style>
  .fm {
    margin-top: 18px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--fg-2);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .line {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    align-items: baseline;
  }
  .row {
    display: inline-flex;
    gap: 6px;
    align-items: baseline;
    line-height: 1.75;
  }
  .row-tags {
    flex-wrap: wrap;
    max-width: 100%;
  }
  .row-tags .v {
    display: inline;
    line-height: 1.7;
  }
  .k {
    color: var(--fg-4);
  }
  .dot {
    color: var(--line-2);
  }
  .v a {
    color: var(--fg-2);
    text-decoration: none;
    border-bottom: 1px solid var(--line-2);
    padding-bottom: 1px;
  }
  .v a:hover {
    color: var(--fg);
    border-bottom-color: var(--fg);
  }
  @media (min-width: 768px) {
    .line {
      justify-content: center;
    }
    .row-tags {
      justify-content: center;
    }
  }
</style>
